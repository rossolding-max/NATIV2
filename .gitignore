.env
.env.*
!.env.example
*.local.json
talents/*.local.json
node_modules/
.DS_Store
scripts/__pycache__/

# Brand Discovery generated output: rewritten on every monthly run.
# The schema (schemas/brand_candidates.schema.json) and the spec
# (docs/brand_discovery.md) are tracked; the generated data is not.
data/brand_candidates/

# Contact Enrichment generated output: contains PII (names, emails,
# phone numbers) and licensed vendor data (Apollo, LinkedIn). The
# schema (schemas/brand_contact.schema.json) and the spec
# (docs/contact_enrichment_workflow.md) are tracked; the generated
# data is NEVER committed.
data/brand_contacts/

# Brand Deals (Phase 1.5): per-talent campaign records with commercial
# KPIs, fees, and licensed third-party data (Tribe Dynamics, etc.).
# Schema (schemas/brand_deal.schema.json) and spec
# (docs/brand_deals_workflow.md) are tracked; the data is NEVER
# committed.
data/brand_deals/

# Agency Profile (Phase 0): single agency-identity file with real
# agent contact details (email, phone), DNS-verified domain config,
# Smartlead mailbox IDs. Schema (schemas/agency_profile.schema.json)
# and spec (docs/agency_setup_workflow.md) are tracked; the data is
# never committed.
data/agency_profile.json

# Deal lifecycle records (Phase 4): per-deal pipeline files with
# commercial data (fees, signed contracts, invoice amounts, payment
# records), brand briefs, content drafts, AND discovery-call prep
# packs (Phase 4.5), AND proposal packs (Phase 4.6), AND contract
# packs (Phase 4.7), AND invoice packs (Phase 4.8: multi-invoice
# per deal driven by LLM-parsed contract payment schedule), AND
# performance report packs (Phase 4.9: post-campaign KPI reports
# aggregated from interim_kpi_snapshots[] with benchmark
# comparisons + LLM narrative). Schemas (schemas/deal.schema.json
# + schemas/discovery_prep_pack.schema.json + schemas/proposal_pack
# .schema.json + schemas/contract_pack.schema.json + schemas/
# invoice_pack.schema.json + schemas/performance_report_pack.schema
# .json) and specs (docs/deal_lifecycle_workflow.md + docs/
# discovery_prep_workflow.md + docs/proposal_pack_workflow.md +
# docs/contract_pack_workflow.md + docs/invoice_workflow.md + docs/
# performance_report_workflow.md) are tracked; the per-deal data
# is NEVER committed. On successful close (all invoices paid +
# final KPIs + final report all three set), the deal auto-archives
# into data/brand_deals/{talent_id}.json (also gitignored).
data/deals/

# Phase 4.7 contract template starters: agency-curated reference
# markdown templates (activewear, CPG, podcast read, etc.) that
# Phase 1 talent onboarding can copy from. Gitignored because real
# legal language may be agency-confidential; sample patterns can be
# documented in docs/contract_pack_workflow.md without committing
# the actual templates.
data/contract_template_starters/

# Outreach enrollments: per-(talent, contact) running sequence
# instances with PII + AI-generated email content. Schema
# (schemas/pitch_enrollment.schema.json) tracked; data never.
data/pitch_enrollments/

# Outreach analytics aggregates: derived from enrollment data.
# Regenerated by scripts/analyze_outreach.py weekly.
data/outreach_analytics/

