# ─────────────────────────────────────────────────────────────────────
# NATIV2 v0.1 — local development .env.example
# Copy to .env and fill in secrets. See docs/configuration.md for full spec.
#
# Required for any local run:
#   POSTGRES_PASSWORD, DB_MASTER_KEY, ANTHROPIC_API_KEY
#
# Required for Phase 3b outreach work:
#   SMARTLEAD_API_KEY, SMARTLEAD_WEBHOOK_SECRET
#
# Required for Phase 4.8/4.9 detection + KPI capture:
#   META_APP_ID + META_APP_SECRET + META_WEBHOOK_VERIFY_TOKEN
#   TIKTOK_CLIENT_KEY + TIKTOK_CLIENT_SECRET
#
# Optional vendors (skip if not testing those phases):
#   EXA_API_KEY (Phase 2 + 4.5/4.6/4.9 research)
#   APOLLO_API_KEY (Phase 3a contact enrichment)
#   LINKEDIN_API_KEY (Phase 3a enrichment fallback)
# ─────────────────────────────────────────────────────────────────────

# ── App identity ─────────────────────────────────────────────────────
NATIV2_ENVIRONMENT=development                          # development | test | production
NATIV2_VERSION=0.1.0

# ── FastAPI (defaults safe — 127.0.0.1 only) ─────────────────────────
NATIV2_BIND_HOST=127.0.0.1
NATIV2_BIND_PORT=8000
# Explicit opt-in to bind to 0.0.0.0 (external exposure). v0.1 is designed
# for 127.0.0.1 only. See docs/auth_and_authorization.md.
NATIV2_EXTERNAL_BIND_CONFIRMED=false
NATIV2_API_WORKERS=1

# ── Postgres (matches docker-compose.yml defaults) ───────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=nativ2
POSTGRES_USER=nativ2
POSTGRES_PASSWORD=                                      # REQUIRED — set any value for local dev
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_PRE_PING=true
POSTGRES_ECHO=false                                     # true to log SQL (dev only)

# ── Postgres column encryption (pgcrypto AES-256) ────────────────────
# Generate via: openssl rand -base64 32
DB_MASTER_KEY=                                          # REQUIRED — never commit

# ── Redis (matches docker-compose.yml defaults) ──────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB_CELERY=0
REDIS_DB_CACHE=1
REDIS_DB_RATELIMIT=2
REDIS_PASSWORD=                                         # empty for local-only

# ── S3 / MinIO (matches docker-compose.yml defaults) ─────────────────
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin                                # MinIO default; safe for local
S3_BUCKET=nativ2-v0-1-local
S3_FORCE_PATH_STYLE=true

# ── Celery (uses redis above) ────────────────────────────────────────
# v0.1 = 2 queues (default + llm_heavy). v2 splits to 4 — see docs/v2_deferred_requirements.md V2-SCALE-01.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT_SECONDS=1800                     # 30 min
CELERY_WORKER_CONCURRENCY_DEFAULT=4
CELERY_WORKER_CONCURRENCY_LLM_HEAVY=2

# ── Anthropic (Claude) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=                                      # REQUIRED — sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS_PER_CALL=8000
ANTHROPIC_PROMPT_CACHING_ENABLED=true
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_RETRIES=3

# ── LLM cost budgets ─────────────────────────────────────────────────
LLM_BUDGET_DAILY_USD=100.0                              # soft alert threshold
LLM_BUDGET_PER_PACK_USD=10.0                            # per-pack soft cap
LLM_BUDGET_HARD_KILL_DAILY_USD=500.0                    # hard kill if exceeded

# ── Smartlead (required for Phase 3b) ────────────────────────────────
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1

# ── Exa web research (required for Phase 2 + 4.5/4.6/4.9) ────────────
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# ── Apollo (optional, Phase 3a contact enrichment) ───────────────────
APOLLO_API_KEY=

# ── LinkedIn (optional, Phase 3a enrichment fallback) ────────────────
LINKEDIN_API_KEY=

# ── Meta Graph (Phase 4.8 detection + Phase 4.9 KPI capture) ─────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ── TikTok (Phase 4.8 + 4.9) ─────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Sentry (optional in dev; recommended in production) ──────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Langfuse (self-hosted; matches docker-compose.yml) ───────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_ENABLED=true

# ── Transactional email (optional) ───────────────────────────────────
TRANSACTIONAL_EMAIL_PROVIDER=none                       # postmark | resend | none
TRANSACTIONAL_EMAIL_API_KEY=
TRANSACTIONAL_EMAIL_FROM=system@nativ2.local

# ── Idempotency ──────────────────────────────────────────────────────
IDEMPOTENCY_DEFAULT_TTL_HOURS=24
IDEMPOTENCY_LONG_RUNNING_TTL_HOURS=168                  # 7d for pack-gen kickoffs

# ── Tasks (long-running operations) ──────────────────────────────────
TASK_RETENTION_DAYS=30
TASK_MAX_PROGRESS_POLL_PER_SECOND=5

# ── Cron schedule overrides (seconds; see docs/architecture.md § 8) ──
CRON_PHASE_4_5_AUTO_FIRE_SECONDS=300                    # 5 min
CRON_PHASE_4_8_DETECTION_STORIES_SECONDS=900            # 15 min
CRON_PHASE_4_8_DETECTION_OTHER_SECONDS=3600             # 1 hr
CRON_PHASE_4_9_KPI_CAPTURE_SECONDS=86400                # daily
CRON_INVOICE_OVERDUE_REMINDERS_SECONDS=86400            # daily
CRON_TALENT_STATS_REFRESH_SECONDS=604800                # weekly
CRON_BRAND_HANDLE_REFRESH_SECONDS=604800                # weekly
CRON_DISCOVERY_RUN_SECONDS=2592000                      # monthly per talent
CRON_ENROLLMENT_STATE_SYNC_SECONDS=300                  # 5 min
CRON_AUTO_ARCHIVE_TRIGGER_CHECK_SECONDS=900             # 15 min

# ── File uploads (presigned PUT to S3) ───────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_PRESIGN_TTL_SECONDS=900                          # 15 min

# ── Memo store ───────────────────────────────────────────────────────
MEMO_INLINE_MAX_KB=32                                   # >32kB rejected in v0.1; S3 offload v0.2

# ── Performance + capacity ───────────────────────────────────────────
MAX_CONCURRENT_PACK_GENERATIONS_PER_AGENCY=5
PACK_GENERATION_TIMEOUT_SECONDS=1800                    # 30 min hard timeout

# ── Safety toggles ───────────────────────────────────────────────────
REQUIRE_IDEMPOTENCY_KEY_ON_WRITES=true
ENFORCE_TEMPLATE_VERSION_BUMP=true                      # GAP-07 + GAP-08 fix enforcement
